{
  "name": "agent-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "副屏 agent 监视器 — M1 骨架",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
