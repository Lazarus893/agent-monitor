{
  "name": "agent-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "副屏 agent 监视器 — 额度、完成事件、每日用量",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm build && electron-builder --mac dir --arm64 && codesign --force --deep -s - \"dist/mac-arm64/Agent Monitor.app\" && codesign --verify --deep --strict \"dist/mac-arm64/Agent Monitor.app\" && echo \"ad-hoc 签名完成\"",
    "install:app": "bash scripts/install-app.sh",
    "icons": "python3 scripts/make-icons.py",
    "shoot": "MONITOR_USER_DATA=\"$TMPDIR/agent-monitor-shoot\" MONITOR_CONFIG_FILE=\"$TMPDIR/agent-monitor-shoot/config.json\" MONITOR_HOOK_TOKEN_FILE=\"$TMPDIR/agent-monitor-shoot/hook-token\" MONITOR_HOOK_PORT=47932 MONITOR_LOG_DIR=\"$TMPDIR/agent-monitor-shoot/logs\" MONITOR_SHOOT=1 electron-vite dev",
    "selftest": "MONITOR_USER_DATA=\"$TMPDIR/agent-monitor-selftest\" MONITOR_CONFIG_FILE=\"$TMPDIR/agent-monitor-selftest/config.json\" MONITOR_HOOK_TOKEN_FILE=\"$TMPDIR/agent-monitor-selftest/hook-token\" MONITOR_HOOK_PORT=47931 MONITOR_LOG_DIR=\"$TMPDIR/agent-monitor-selftest/logs\" MONITOR_SELFTEST=1 electron-vite dev",
    "test": "vitest run",
    "soak": "node scripts/soak.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^22.18.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
